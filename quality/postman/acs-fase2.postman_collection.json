          "raw": "{\"codigo\": \"QA-{{runId}}\", \"tipo\": \"APARTAMENTO\", \"titulo\": \"Apartamento de prueba\", \"direccion\": \"Zona de prueba de ACS\", \"renta_mensual\": 1000}"
