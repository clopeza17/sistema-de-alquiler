        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"message\",\"data\"],\"properties\":{\"message\":{\"type\":\"string\"},\"data\":{\"type\":\"object\",\"required\":[\"id\"],\"properties\":{\"id\":{\"type\":\"integer\"}}}}}));",
              "pm.test('Contenido de negocio', () => {",
              "  const response = pm.response.json();",
              "  pm.expect(response.data.id).to.be.above(0);",
              "  pm.collectionVariables.set(\"propertyId\", response.data.id);",
              "});"
