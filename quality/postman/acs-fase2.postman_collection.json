{
  "info": {
    "name": "ACS Fase 2 | Contratos, facturación y pagos",
    "description": "Ejecutar sobre una base QA recién inicializada. El flujo crea datos sintéticos, genera una factura y aplica su pago. Definir baseUrl, adminEmail y adminPassword en un entorno externo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:13001"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Salud del servicio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"status\",\"version\"],\"properties\":{\"status\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"}}}));",
              "pm.test('Contenido de negocio', () => {",
              "  const response = pm.response.json();",
              "  pm.expect(response.status).to.eql(\"OK\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Contratos sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"error\"],\"properties\":{\"error\":{\"type\":\"object\",\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}));",
              "pm.test('Contenido de negocio', () => {",
              "  const response = pm.response.json();",
              "  pm.expect(response.error.code).to.eql(\"UNAUTHORIZED\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/contratos",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "03 Login con usuario inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"error\"],\"properties\":{\"error\":{\"type\":\"object\",\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}));",
              "pm.test('Contenido de negocio', () => {",
              "  const response = pm.response.json();",
              "  pm.expect(response.error.message).to.eql(\"Credenciales inválidas\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"no-existe@example.invalid\", \"password\": \"ClavePruebaInvalida1\"}"
        }
      }
    },
    {
      "name": "04 Login de la cuenta QA",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"success\",\"data\"],\"properties\":{\"success\":{\"type\":\"boolean\"},\"data\":{\"type\":\"object\",\"required\":[\"user\",\"token\"],\"properties\":{\"user\":{\"type\":\"object\",\"required\":[\"id\",\"email\",\"roles\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"email\":{\"type\":\"string\"},\"roles\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}},\"token\":{\"type\":\"string\"}}}}}));",
              "pm.test('Contenido de negocio', () => {",
              "  const response = pm.response.json();",
              "  pm.expect(response.success).to.eql(true);",
              "  pm.expect(response.data.user.roles).to.include(\"Administrador\");",
              "  pm.expect(response.data.user.email).to.eql(pm.variables.get(\"adminEmail\"));",
              "  pm.expect(response.data.token.split(\".\")).to.have.lengthOf(3);",
              "  pm.collectionVariables.set(\"token\", response.data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
        }
      }
    },
