# Variables de entorno para MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=sistema_alquiler
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# Puerto de MySQL
MYSQL_PORT=3306

# Puerto de phpMyAdmin
PHPMYADMIN_PORT=8080

# Puertos de la aplicación
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Cambiar por un valor aleatorio de al menos 32 caracteres antes de iniciar Docker
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
